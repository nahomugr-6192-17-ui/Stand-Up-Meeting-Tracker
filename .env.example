# ==============================================================================
# MUQECHA STUDIOS — STAND-UP MEETING NOTES TRACKER ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Port
PORT=5000

# Client Application URL (for CORS and redirects)
CLIENT_URL=http://localhost:5173

# Node Environment ('development' | 'production')
NODE_ENV=development

# Session Cookie Secret Key (Change to a strong random string in production)
COOKIE_SECRET=change-this-to-a-secure-random-secret-key-in-production

# ==============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# ==============================================================================
# PostgreSQL Connection URL format:
# postgresql://<username>:<password>@<host>:<port>/<database>?schema=public
# If unset, the application automatically uses embedded persistent PostgreSQL storage in ./data/pgdata
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/muqecha_standup?schema=public

# ==============================================================================
# PROVISIONED ACCOUNTS (Configured securely via environment variables)
# ==============================================================================

# Team Account (Read-only access)
TEAM_USERNAME=Muqecha Team
TEAM_PASSWORD=replace_with_team_secure_password

# Administrator Account (Full meeting management access)
ADMIN_USERNAME=Muqecha Admin
ADMIN_PASSWORD=replace_with_admin_secure_password

